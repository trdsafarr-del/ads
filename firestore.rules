rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDisplayOrientation(val) {
      return val is string && (
        val == 'LANDSCAPE' ||
        val == 'PORTRAIT' ||
        val == 'REVERSE_LANDSCAPE' ||
        val == 'REVERSE_PORTRAIT'
      );
    }

    function isValidVideoOrientation(val) {
      return val is string && (
        val == 'AUTO' ||
        val == 'LANDSCAPE' ||
        val == 'PORTRAIT'
      );
    }

    function isValidScaleMode(val) {
      return val is string && (
        val == 'ZOOM' ||
        val == 'FIT' ||
        val == 'FILL'
      );
    }

    function isValidSignageCloudVideo(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 2048 &&
             data.durationSeconds is int && data.durationSeconds >= 1 && data.durationSeconds <= 86400 &&
             data.order is int && data.order >= 0 && data.order <= 10000 &&
             isValidVideoOrientation(data.videoOrientation) &&
             data.isForcedPlay is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSignageCloudDevice(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.pairCode is string && data.pairCode.size() >= 4 && data.pairCode.size() <= 16 &&
             data.status is string && data.status.size() >= 1 && data.status.size() <= 64 &&
             isValidDisplayOrientation(data.screenOrientation) &&
             isValidVideoOrientation(data.videoOrientation) &&
             data.currentVideoTitle is string && data.currentVideoTitle.size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSignageCloudConfig(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             isValidDisplayOrientation(data.orientation) &&
             isValidVideoOrientation(data.videoOrientation) &&
             isValidScaleMode(data.scaleMode) &&
             data.pushedVideoId is string && data.pushedVideoId.size() <= 128 &&
             data.pushedVideoTimestamp is int && data.pushedVideoTimestamp >= 0 &&
             data.version is int && data.version >= 1 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCmsGlobalState(data) {
      return data.stateJson is string && data.stateJson.size() >= 2 && data.stateJson.size() <= 900000 &&
             data.updatedAtMs is int && data.updatedAtMs >= 0;
    }

    function isValidCmsUploadChunk(data) {
      return data.videoId is string && data.videoId.size() >= 1 && data.videoId.size() <= 128 &&
             data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex <= 200 &&
             data.totalChunks is int && data.totalChunks >= 1 && data.totalChunks <= 200 &&
             data.data is string && data.data.size() >= 1 && data.data.size() <= 950000 &&
             (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 64)) &&
             data.updatedAtMs is int && data.updatedAtMs >= 0;
    }

    match /cms_global/{docId} {
      allow get: if isValidId(docId);
      allow list: if false;
      allow create: if isValidId(docId) &&
                       incoming().keys().hasAll(['stateJson', 'updatedAtMs']) &&
                       incoming().keys().hasOnly(['stateJson', 'updatedAtMs']) &&
                       isValidCmsGlobalState(incoming());
      allow update: if isValidId(docId) &&
                       isValidCmsGlobalState(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['stateJson', 'updatedAtMs']);
      allow delete: if false;
    }

    match /cms_uploads/{chunkId} {
      allow get: if isValidId(chunkId);
      allow list: if false;
      allow create: if isValidId(chunkId) &&
                       incoming().keys().hasAll(['videoId', 'chunkIndex', 'totalChunks', 'data', 'updatedAtMs']) &&
                       incoming().keys().hasOnly(['videoId', 'chunkIndex', 'totalChunks', 'data', 'mimeType', 'updatedAtMs']) &&
                       isValidCmsUploadChunk(incoming());
      allow update: if isValidId(chunkId) &&
                       isValidCmsUploadChunk(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['videoId', 'chunkIndex', 'totalChunks', 'data', 'mimeType', 'updatedAtMs']);
      allow delete: if isValidId(chunkId);
    }

    match /users/{userId}/videos/{videoId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(videoId) && request.auth.uid == userId && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(videoId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'title', 'videoUrl', 'durationSeconds', 'order', 'videoOrientation', 'isForcedPlay', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'videoUrl', 'durationSeconds', 'order', 'videoOrientation', 'isForcedPlay', 'createdAt', 'updatedAt']) &&
                       isValidSignageCloudVideo(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(videoId) &&
                       request.auth.uid == userId &&
                       isValidSignageCloudVideo(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'videoUrl', 'durationSeconds', 'order', 'videoOrientation', 'isForcedPlay', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(videoId) &&
                       request.auth.uid == userId &&
                       existing().userId == request.auth.uid;
    }

    match /users/{userId}/devices/{deviceId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(deviceId) && request.auth.uid == userId && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(deviceId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'deviceId', 'name', 'pairCode', 'status', 'screenOrientation', 'videoOrientation', 'currentVideoTitle', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'deviceId', 'name', 'pairCode', 'status', 'screenOrientation', 'videoOrientation', 'currentVideoTitle', 'createdAt', 'updatedAt']) &&
                       isValidSignageCloudDevice(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(deviceId) &&
                       request.auth.uid == userId &&
                       isValidSignageCloudDevice(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().deviceId == existing().deviceId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'pairCode', 'status', 'screenOrientation', 'videoOrientation', 'currentVideoTitle', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(deviceId) &&
                       request.auth.uid == userId &&
                       existing().userId == request.auth.uid;
    }

    match /users/{userId}/config/{configId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(configId) && request.auth.uid == userId && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(configId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'orientation', 'videoOrientation', 'scaleMode', 'pushedVideoId', 'pushedVideoTimestamp', 'version', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'orientation', 'videoOrientation', 'scaleMode', 'pushedVideoId', 'pushedVideoTimestamp', 'version', 'createdAt', 'updatedAt']) &&
                       isValidSignageCloudConfig(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(configId) &&
                       request.auth.uid == userId &&
                       isValidSignageCloudConfig(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['orientation', 'videoOrientation', 'scaleMode', 'pushedVideoId', 'pushedVideoTimestamp', 'version', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(configId) &&
                       request.auth.uid == userId &&
                       existing().userId == request.auth.uid;
    }
  }
}
