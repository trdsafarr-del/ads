{
  "entities": {
    "SignageCloudVideo": {
      "title": "SignageCloudVideo",
      "description": "Represents a video item in the user's real-time cloud signage loop.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "videoUrl": { "type": "string" },
        "durationSeconds": { "type": "integer" },
        "order": { "type": "integer" },
        "videoOrientation": { "type": "string", "enum": ["AUTO", "LANDSCAPE", "PORTRAIT"] },
        "isForcedPlay": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "videoUrl", "durationSeconds", "order", "videoOrientation", "isForcedPlay", "createdAt", "updatedAt"]
    },
    "SignageCloudDevice": {
      "title": "SignageCloudDevice",
      "description": "Represents a paired Android TV signage screen and its per-device orientation settings.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "deviceId": { "type": "string" },
        "name": { "type": "string" },
        "pairCode": { "type": "string" },
        "status": { "type": "string" },
        "screenOrientation": { "type": "string", "enum": ["LANDSCAPE", "PORTRAIT", "REVERSE_LANDSCAPE", "REVERSE_PORTRAIT"] },
        "videoOrientation": { "type": "string", "enum": ["AUTO", "LANDSCAPE", "PORTRAIT"] },
        "currentVideoTitle": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "deviceId", "name", "pairCode", "status", "screenOrientation", "videoOrientation", "currentVideoTitle", "createdAt", "updatedAt"]
    },
    "SignageCloudConfig": {
      "title": "SignageCloudConfig",
      "description": "Global broadcast configuration and instant force-play command state.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orientation": { "type": "string", "enum": ["LANDSCAPE", "PORTRAIT", "REVERSE_LANDSCAPE", "REVERSE_PORTRAIT"] },
        "videoOrientation": { "type": "string", "enum": ["AUTO", "LANDSCAPE", "PORTRAIT"] },
        "scaleMode": { "type": "string", "enum": ["ZOOM", "FIT", "FILL"] },
        "pushedVideoId": { "type": "string" },
        "pushedVideoTimestamp": { "type": "integer" },
        "version": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "orientation", "videoOrientation", "scaleMode", "pushedVideoId", "pushedVideoTimestamp", "version", "createdAt", "updatedAt"]
    },
    "CmsGlobalState": {
      "title": "CmsGlobalState",
      "description": "Shared real-time state across Vercel serverless functions, Web CMS Dashboard, and Kiosk Android TVs.",
      "type": "object",
      "properties": {
        "stateJson": { "type": "string" },
        "updatedAtMs": { "type": "integer" }
      },
      "required": ["stateJson", "updatedAtMs"]
    },
    "CmsUploadChunk": {
      "title": "CmsUploadChunk",
      "description": "Binary base64 MP4 chunk stored in Cloud Firestore for cross-instance serverless and Android TV video streaming.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "chunkIndex": { "type": "integer" },
        "totalChunks": { "type": "integer" },
        "data": { "type": "string" },
        "mimeType": { "type": "string" },
        "updatedAtMs": { "type": "integer" }
      },
      "required": ["videoId", "chunkIndex", "totalChunks", "data", "updatedAtMs"]
    }
  },
  "firestore": {
    "/users/{userId}/videos/{videoId}": {
      "schema": { "$ref": "#/entities/SignageCloudVideo" },
      "description": "Real-time cloud playlist videos scoped per authenticated user."
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/SignageCloudDevice" },
      "description": "Real-time paired Android TV devices scoped per authenticated user."
    },
    "/users/{userId}/config/{configId}": {
      "schema": { "$ref": "#/entities/SignageCloudConfig" },
      "description": "Real-time signage broadcast configuration scoped per authenticated user."
    },
    "/cms_global/{docId}": {
      "schema": { "$ref": "#/entities/CmsGlobalState" },
      "description": "Shared real-time kiosk state synced across Vercel serverless functions and Android TV."
    },
    "/cms_uploads/{chunkId}": {
      "schema": { "$ref": "#/entities/CmsUploadChunk" },
      "description": "Uploaded MP4 video chunks for cross-instance Vercel and Android TV playback."
    }
  }
}
